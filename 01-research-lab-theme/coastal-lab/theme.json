{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "72rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": false,
			"palette": [
				{ "slug": "ink", "name": "Ink", "color": "#13212b" },
				{ "slug": "paper", "name": "Paper", "color": "#ffffff" },
				{ "slug": "sea", "name": "Sea", "color": "#0b5d73" },
				{ "slug": "sea-dark", "name": "Deep Sea", "color": "#073f4e" },
				{ "slug": "sand", "name": "Sand", "color": "#f4efe6" },
				{ "slug": "muted", "name": "Muted", "color": "#4a5a65" }
			]
		},
		"typography": {
			"customFontSize": false,
			"fontFamilies": [
				{ "slug": "body", "name": "Body", "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif" },
				{ "slug": "heading", "name": "Heading", "fontFamily": "Georgia, \"Times New Roman\", serif" }
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.9375rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem" },
				{ "slug": "large", "name": "Large", "size": "1.25rem" },
				{ "slug": "x-large", "name": "Extra large", "size": "clamp(1.5rem, 3vw, 2rem)" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"elements": {
			"link": { "color": { "text": "var(--wp--preset--color--sea)" } },
			"heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--heading)" } }
		},
		"typography": { "fontFamily": "var(--wp--preset--font-family--body)" }
	}
}
